datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["public", "tenant_shared"]
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

model Tenant {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String    @db.VarChar(255)
  createdAt     DateTime? @default(now()) @map("created_at") @db.Timestamptz
  logo          String?   @db.VarChar
  slug          String?   @db.VarChar(255)
  dbModel       String    @default("SHARED") @map("db_model")
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz
  status        String    @default("active")
  description   String?
  website       String?
  businessEmail String?   @map("business_email")
  phoneNumber   String?   @map("phone_number")
  taxId         String?   @map("tax_id")
  defaultLocale String?   @map("default_locale")
  timezone      String?
  currency      String?
  addressLine1  String?   @map("address_line1")
  addressLine2  String?   @map("address_line2")
  city          String?
  stateProvince String?   @map("state_province")
  postalCode    String?   @map("postal_code")
  countryCode   String?   @map("country_code")
  kecamatan     String?
  desa          String?
  theme         Json?     @default("{}")

  // Relations
  tasks        Task[]
  apiKeys      ApiKey[]
  transactions Transaction[]
  subscription Subscription?
  memberships  Membership[]
  invitations  Invitation[]

  @@map("tenants")
  @@schema("public")
}

model Profile {
  id                String    @id @db.Uuid
  fullName          String?   @map("full_name") @db.VarChar(255)
  createdAt         DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  avatar            String?   @db.VarChar
  preferredLanguage String?   @default("en") @map("preferred_language")
  timezone          String?   @default("UTC")
  isSuperadmin      Boolean   @default(false) @map("is_superadmin")
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz
  status            String    @default("active")
  bannedUntil       DateTime? @map("banned_until") @db.Timestamptz
  bannedReason      String?   @map("banned_reason")
  description       String?
  phone             String?
  currency          String?
  addressLine1      String?   @map("address_line1")
  addressLine2      String?   @map("address_line2")
  addressCity       String?   @map("address_city")
  addressRegion     String?   @map("address_region")
  addressPostalCode String?   @map("address_postal_code")
  addressCountry    String?   @map("address_country")
  addressKecamatan  String?   @map("address_kecamatan")
  addressDesa       String?   @map("address_desa")
  theme             Json?     @default("{}")

  // Relations
  memberships     Membership[]
  tasksAssigned   Task[]       @relation("TaskAssignee")
  tasksCreated    Task[]       @relation("TaskCreator")
  invitationsSent Invitation[] @relation("InvitationSender")

  @@map("profiles")
  @@schema("public")
}

model Role {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String    @unique
  hierarchyLevel Int       @default(0) @map("hierarchy_level")
  createdAt      DateTime? @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  permissions RolePermission[]
  memberships Membership[]
  invitations Invitation[]

  @@map("roles")
  @@schema("public")
}

model Permission {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String    @unique
  description String?
  createdAt   DateTime? @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  roles RolePermission[]

  @@map("permissions")
  @@schema("public")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  // Relations
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
  @@schema("public")
}

model Membership {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamptz
  roleId    String?   @map("role_id") @db.Uuid

  // Relations
  user   Profile @relation(fields: [userId], references: [id])
  tenant Tenant  @relation(fields: [tenantId], references: [id])
  role   Role?   @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([userId, tenantId])
  @@map("memberships")
  @@schema("public")
}

model Invitation {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  email     String    @db.VarChar(255)
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamptz
  expiresAt DateTime? @default(dbgenerated("(now() + '7 days'::interval)")) @map("expires_at") @db.Timestamptz
  invitedBy String?   @map("invited_by") @db.Uuid
  roleId    String?   @map("role_id") @db.Uuid

  // Relations
  tenant Tenant   @relation(fields: [tenantId], references: [id])
  sender Profile? @relation("InvitationSender", fields: [invitedBy], references: [id], onDelete: SetNull)
  role   Role?    @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([tenantId, email])
  @@map("invitations")
  @@schema("public")
}

model Subscription {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId               String    @unique @map("tenant_id") @db.Uuid
  planId                 String?   @map("plan_id")
  status                 String
  cancelAtPeriodEnd      Boolean?  @default(false) @map("cancel_at_period_end")
  startsAt               DateTime  @default(dbgenerated("timezone('utc'::text, now())")) @map("starts_at") @db.Timestamptz
  endsAt                 DateTime? @map("ends_at") @db.Timestamptz
  providerSubscriptionId String?   @map("provider_subscription_id")
  providerCustomerId     String?   @map("provider_customer_id")
  updatedAt              DateTime  @default(dbgenerated("timezone('utc'::text, now())")) @map("updated_at") @db.Timestamptz
  provider               String?
  pendingPlanId          String?   @map("pending_plan_id")
  interval               String?

  // Relations
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
  @@schema("public")
}

model Transaction {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  amount          Decimal  @db.Decimal(10, 2)
  currency        String?  @default("USD")
  planName        String   @map("plan_name")
  orderId         String   @unique @map("order_id")
  status          String
  createdAt       DateTime @default(dbgenerated("timezone('utc'::text, now())")) @map("created_at") @db.Timestamptz
  provider        String?
  amountInIdr     Decimal? @map("amount_in_idr") @db.Decimal(10, 2)
  exchangeRate    Decimal? @map("exchange_rate") @db.Decimal(10, 4)
  exchangeApiUsed String?  @map("exchange_api_used")
  taxAmount       Decimal? @default(0) @map("tax_amount") @db.Decimal(10, 2)
  netAmount       Decimal? @default(0) @map("net_amount") @db.Decimal(10, 2)
  feeAmount       Decimal? @default(0) @map("fee_amount") @db.Decimal(10, 2)

  // Relations
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("transactions")
  @@schema("public")
}

model Plan {
  id              String   @id
  name            String
  description     String
  isActive        Boolean  @default(true) @map("is_active")
  displayFeatures String[] @default([]) @map("display_features")
  features        String[] @default([])
  createdAt       DateTime @default(dbgenerated("timezone('utc'::text, now())")) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @default(dbgenerated("timezone('utc'::text, now())")) @map("updated_at") @db.Timestamptz

  prices PlanPrice[]

  @@index([isActive])
  @@map("plans")
  @@schema("public")
}

model PlanPrice {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  planId      String   @map("plan_id")
  interval    String
  amount      Decimal  @db.Decimal(10, 2)
  providerIds Json     @default("{}") @map("provider_ids")
  createdAt   DateTime @default(dbgenerated("timezone('utc'::text, now())")) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @default(dbgenerated("timezone('utc'::text, now())")) @map("updated_at") @db.Timestamptz

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, interval])
  @@index([planId])
  @@map("plan_prices")
  @@schema("public")
}

model Coupon {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code           String   @unique
  discountType   String   @map("discount_type")
  discountValue  Decimal  @map("discount_value") @db.Decimal(10, 2)
  validUntil     DateTime? @map("valid_until") @db.Timestamptz
  maxRedemptions Int?     @map("max_redemptions")
  redeemedCount  Int      @default(0) @map("redeemed_count")
  createdAt      DateTime @default(dbgenerated("timezone('utc'::text, now())")) @map("created_at") @db.Timestamptz

  redemptions CouponRedemption[]

  @@map("coupons")
  @@schema("public")
}

model CouponRedemption {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  couponId  String   @map("coupon_id") @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  redeemedAt DateTime @default(dbgenerated("timezone('utc'::text, now())")) @map("redeemed_at") @db.Timestamptz

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)

  @@unique([couponId, tenantId])
  @@map("coupon_redemptions")
  @@schema("public")
}

model Task {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  title       String?   @db.VarChar(255)
  createdAt   DateTime? @default(now()) @map("created_at") @db.Timestamptz
  description String?
  status      String    @default("todo")
  priority    String    @default("medium")
  dueDate     DateTime? @map("due_date") @db.Timestamptz
  assigneeId  String?   @map("assignee_id") @db.Uuid
  createdBy   String?   @map("created_by") @db.Uuid
  updatedAt   DateTime  @default(now()) @map("updated_at") @db.Timestamptz

  // Relations
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignee Profile? @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  creator  Profile? @relation("TaskCreator", fields: [createdBy], references: [id], onDelete: SetNull)

  @@map("tasks")
  @@schema("tenant_shared")
}

model ApiKey {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  name       String
  keyPrefix  String    @map("key_prefix")
  keyHash    String    @unique @map("key_hash")
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz
  lastUsedIp String?   @map("last_used_ip")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz

  // Relations
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("api_keys")
  @@schema("tenant_shared")
}